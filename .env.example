# Copy to apps/web/.env.local for local Node development. Never commit filled values.
# For Workers put server values in Wrangler secrets; see INSTALL_HE.md.
# Use the Supabase transaction-pooler connection string with a dedicated mozes_app login.
# Example format: postgresql://mozes_app.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:6543/postgres?sslmode=verify-full
DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Local Node only; Workers requires R2/S3 and rejects the local driver.
MEDIA_DRIVER=none
MEDIA_LOCAL_DIR=.media
# Optional R2 alternative. The development deployment uses Supabase S3 without a payment method.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
# A different origin from BETTER_AUTH_URL, e.g. http://127.0.0.1:3000 for local tests.
PACKAGE_ORIGIN=
# Generic S3 remains available for media. Supabase Storage does not serve playable HTML.
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
# Required private bucket for new Schema v2 assets; existing public bucket is retained for legacy content.
S3_PRIVATE_BUCKET=mozes-private
S3_PUBLIC_BASE_URL=
AUTH_SIGNIN_RATE_LIMIT_PER_MIN=10
# Optional per-object provider limit, included in the browser build. Supabase Free: 52428800.
NEXT_PUBLIC_MEDIA_MAX_BYTES=
# Set only in the Worker environment (already set by wrangler.jsonc):
# DEPLOY_TARGET=cloudflare
