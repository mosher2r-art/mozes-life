{
  "name": "@mozes/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm assets:bundle && next dev",
    "build": "pnpm assets:bundle && next build",
    "start": "next start",
    "typecheck": "pnpm assets:bundle && tsc --noEmit",
    "lint": "eslint src scripts e2e",
    "test": "pnpm assets:bundle && vitest run --passWithNoTests --dir src",
    "e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "user:create": "tsx scripts/create-user.ts",
    "demo:publish": "tsx scripts/publish-demo.ts",
    "bootstrap": "tsx scripts/bootstrap.ts",
    "start:hosted": "pnpm db:migrate && pnpm bootstrap && next start",
    "assets:bundle": "tsx scripts/bundle-scorm.ts",
    "build:worker": "opennextjs-cloudflare build",
    "preview:worker": "opennextjs-cloudflare preview",
    "deploy:worker": "opennextjs-cloudflare deploy",
    "sql:generate": "tsx scripts/generate-supabase.ts",
    "sql:verify": "tsx scripts/verify-supabase.ts",
    "import:local": "pnpm assets:bundle && node --conditions=react-server --import tsx scripts/import-local.ts"
  },
  "dependencies": {
    "@fontsource/heebo": "5.3.0",
    "@mozes/authz": "workspace:*",
    "@mozes/content-schema": "workspace:*",
    "@mozes/player-core": "workspace:*",
    "@mozes/player-react": "workspace:*",
    "@mozes/validator": "workspace:*",
    "aws4fetch": "1.0.20",
    "better-auth": "1.7.10",
    "drizzle-orm": "0.45.4",
    "fast-xml-parser": "5.11.2",
    "next": "16.4.2",
    "pg": "8.23.1",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "scorm-again": "3.4.6",
    "server-only": "0.0.1",
    "yauzl": "3.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@opennextjs/cloudflare": "1.20.15",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/yauzl": "^3.4.0",
    "drizzle-kit": "0.31.11",
    "tsx": "^4.23.15",
    "wrangler": "4.156.0"
  }
}
